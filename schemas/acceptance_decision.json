{
  "$id": "https://bdsk.dev/schemas/acceptance_decision.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BDSK Acceptance Decision",
  "description": "Schema for acceptance_decision artifacts per BDSK v0.3. Records the final approval, rejection, or conditional acceptance of a generated implementation.",
  "allOf": [
    { "$ref": "common.json#/$defs/artifactEnvelope" },
    {
      "properties": {
        "kind": { "const": "acceptance_decision" },
        "status": {
          "type": "string",
          "enum": ["recorded", "superseded"]
        },
        "metadata": {
          "type": "object",
          "required": ["outcome"],
          "properties": {
            "outcome": {
              "type": "string",
              "enum": ["accepted", "rejected", "conditionally_accepted"]
            }
          },
          "additionalProperties": false
        },
        "spec": {
          "type": "object",
          "required": [
            "subject_diffs",
            "decision_summary",
            "reasons",
            "conditions",
            "residual_risks",
            "approvers"
          ],
          "properties": {
            "subject_diffs": {
              "type": "array",
              "items": { "$ref": "common.json#/$defs/id" }
            },
            "decision_summary": { "type": "string", "minLength": 1 },
            "reasons": {
              "type": "array",
              "items": { "type": "string" }
            },
            "conditions": {
              "type": "array",
              "items": { "type": "string" }
            },
            "residual_risks": {
              "type": "array",
              "items": { "type": "string" }
            },
            "approvers": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["metadata", "spec"]
    }
  ]
}
