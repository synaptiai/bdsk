{
  "$id": "https://bdsk.dev/schemas/behavior_spec.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BDSK Behavior Spec",
  "description": "Schema for behavior_spec artifacts per BDSK v0.3. Defines observable expected behavior in a form that can govern AI implementation and verification.",
  "allOf": [
    { "$ref": "common.json#/$defs/artifactEnvelope" },
    {
      "properties": {
        "kind": { "const": "behavior_spec" },
        "status": {
          "type": "string",
          "enum": ["draft", "approved", "superseded", "archived"]
        },
        "metadata": {
          "type": "object",
          "required": ["tags"],
          "properties": {
            "tags": {
              "type": "array",
              "items": { "type": "string" }
            },
            "domain": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "spec": {
          "type": "object",
          "required": [
            "actor",
            "goal",
            "preconditions",
            "trigger",
            "examples",
            "observable_outcomes"
          ],
          "properties": {
            "actor": { "type": "string", "minLength": 1 },
            "goal": { "type": "string", "minLength": 1 },
            "preconditions": {
              "type": "array",
              "items": { "type": "string" }
            },
            "trigger": {
              "type": "object",
              "required": ["type", "action"],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["event", "request", "command", "schedule"]
                },
                "action": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            },
            "examples": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["id", "given", "when", "then"],
                "properties": {
                  "id": { "$ref": "common.json#/$defs/id" },
                  "given": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "when": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "then": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "and": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                },
                "additionalProperties": false
              }
            },
            "observable_outcomes": {
              "type": "array",
              "items": { "type": "string" }
            },
            "linked_assumptions": {
              "type": "array",
              "items": { "$ref": "common.json#/$defs/id" }
            },
            "linked_contracts": {
              "type": "array",
              "items": { "$ref": "common.json#/$defs/id" }
            },
            "non_goals": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["metadata", "spec"]
    }
  ]
}
