{
  "name": "bdsk-validator",
  "version": "0.1.0",
  "description": "Reference validator for the BDSK v0.3 specification",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "bdsk-validate": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
